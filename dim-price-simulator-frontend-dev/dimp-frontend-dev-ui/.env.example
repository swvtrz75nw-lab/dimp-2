# DIM Price Simulator Frontend — Environment Variables
#
# Copy this file to .env and fill in values for your environment.
# Vite exposes these as import.meta.env.VITE_*

# ─── DIM Price Agent (Chat SSE streaming) ───
# The agent that answers pricing questions at runtime
VITE_API_BASE_URL=http://localhost:5012

# ─── Onboarding Service ───
# Leave empty to use Vite proxy (recommended for local dev).
# Set to full URL for direct access (e.g. deployed environments).
# When empty, requests to /api/onboarding_service are proxied to localhost:8000 via vite.config.js
VITE_ONBOARDING_API_URL=

# ─── Mock API Base (legacy) ───
# When set, general UI endpoints (user, navigation, notifications) hit this URL.
# When empty, falls back to local mock data.
VITE_API_MOCK_BASE_URL=

# ─── Mock latency (ms) ───
# Simulated delay for mock API responses (default: 320ms)
VITE_MOCK_LATENCY=320
